{
  "name": "orkidea-cra",
  "private": true,
  "type": "module",
  "workspaces": [
    "api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ensure-assets": "node scripts/ensure-assets.mjs",
    "dev:api": "npm run ensure-assets && npm run dev -w api",
