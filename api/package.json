{
  "name": "orkidea-cra-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply orkidea-cra --local",
    "db:seed:local": "wrangler d1 execute orkidea-cra --local --file=seed/dev.sql",
    "db:migrate:remote": "wrangler d1 migrations apply orkidea-cra --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.20",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "private": true,
  "type": "module"
}
